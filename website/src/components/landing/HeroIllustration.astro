<svg viewBox="0 0 560 420" class="w-full" xmlns="http://www.w3.org/2000/svg" role="img"
     aria-label="Diagram: one native libccl core serving Python, Go, Rust, and JavaScript over a C ABI">
  <defs>
    <linearGradient id="coreGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a2b52"/>
      <stop offset="100%" stop-color="#0d1730"/>
    </linearGradient>
    <linearGradient id="coreStroke" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#8ab6ff"/>
      <stop offset="100%" stop-color="#14b8a6"/>
    </linearGradient>
    <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#4f8ef7" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#4f8ef7" stop-opacity="0"/>
    </radialGradient>
    <filter id="soft"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>

  <!-- ambient glow -->
  <circle cx="280" cy="210" r="190" fill="url(#coreGlow)"/>

  <!-- connection lines: core → language nodes -->
  <g stroke-width="1.6" fill="none">
    <path d="M 233 165 L 118 92"  stroke="#f7df1e" opacity="0.55" class="flow-line"/>
    <path d="M 327 165 L 442 92"  stroke="#00add8" opacity="0.55" class="flow-line"/>
    <path d="M 233 255 L 118 328" stroke="#f74c00" opacity="0.55" class="flow-line"/>
    <path d="M 327 255 L 442 328" stroke="#3776ab" opacity="0.8"  class="flow-line"/>
  </g>

  <!-- core: hexagon libccl -->
  <g filter="url(#soft)">
    <polygon points="280,130 348,170 348,250 280,290 212,250 212,170"
             fill="url(#coreGrad)" stroke="url(#coreStroke)" stroke-width="2"/>
  </g>
  <text x="280" y="200" text-anchor="middle" fill="#ffffff" font-size="22" font-weight="700" font-family="'JetBrains Mono', monospace">libccl</text>
  <text x="280" y="224" text-anchor="middle" fill="#8ab6ff" font-size="11" font-family="'JetBrains Mono', monospace">GraalVM native-image</text>
  <text x="280" y="243" text-anchor="middle" fill="#9aa3b2" font-size="10" font-family="'JetBrains Mono', monospace">Cardano Client Lib</text>

  <!-- C ABI ring -->
  <circle cx="280" cy="210" r="103" fill="none" stroke="#2a3a63" stroke-width="1" stroke-dasharray="3 5" class="pulse-slow"/>
  <rect x="252" y="300" width="56" height="18" rx="9" fill="#0d1426" stroke="#2a3a63"/>
  <text x="280" y="313" text-anchor="middle" fill="#8ab6ff" font-size="10" font-family="'JetBrains Mono', monospace">C ABI</text>

  <!-- language nodes -->
  <g font-family="'JetBrains Mono', monospace" font-size="13" font-weight="600">
    <g>
      <rect x="40" y="62" width="128" height="44" rx="12" fill="#0d1426" stroke="#f7df1e" stroke-opacity="0.5"/>
      <circle cx="62" cy="84" r="5" fill="#f7df1e"/>
      <text x="76" y="89" fill="#e4e4e7">JavaScript</text>
    </g>
    <g>
      <rect x="398" y="62" width="122" height="44" rx="12" fill="#0d1426" stroke="#00add8" stroke-opacity="0.5"/>
      <circle cx="420" cy="84" r="5" fill="#00add8"/>
      <text x="434" y="89" fill="#e4e4e7">Go</text>
    </g>
    <g>
      <rect x="40" y="308" width="128" height="44" rx="12" fill="#0d1426" stroke="#f74c00" stroke-opacity="0.5"/>
      <circle cx="62" cy="330" r="5" fill="#f74c00"/>
      <text x="76" y="335" fill="#e4e4e7">Rust</text>
    </g>
    <g>
      <rect x="398" y="308" width="122" height="44" rx="12" fill="#0d1426" stroke="#3776ab" stroke-opacity="0.6"/>
      <circle cx="420" cy="330" r="5" fill="#4d9fdb"/>
      <text x="434" y="335" fill="#e4e4e7">Python</text>
    </g>
  </g>

  <!-- floating chips: what flows across -->
  <g font-family="'JetBrains Mono', monospace" font-size="9">
    <rect x="150" y="120" width="88" height="16" rx="8" fill="#101a33" stroke="#2a3a63"/>
    <text x="194" y="131" text-anchor="middle" fill="#9aa3b2">TxPlan YAML →</text>
    <rect x="330" y="120" width="80" height="16" rx="8" fill="#101a33" stroke="#2a3a63"/>
    <text x="370" y="131" text-anchor="middle" fill="#9aa3b2">→ tx_cbor</text>
    <rect x="150" y="284" width="88" height="16" rx="8" fill="#101a33" stroke="#2a3a63"/>
    <text x="194" y="295" text-anchor="middle" fill="#9aa3b2">sign_tx →</text>
    <rect x="330" y="284" width="80" height="16" rx="8" fill="#101a33" stroke="#2a3a63"/>
    <text x="370" y="295" text-anchor="middle" fill="#9aa3b2">offline ✓</text>
  </g>

  <!-- no JVM badge -->
  <g class="pulse-slow">
    <rect x="238" y="30" width="84" height="22" rx="11" fill="#0d1a2e" stroke="#14b8a6" stroke-opacity="0.6"/>
    <text x="280" y="45" text-anchor="middle" fill="#5eead4" font-size="11" font-weight="700" font-family="'JetBrains Mono', monospace">no JVM</text>
  </g>
</svg>
